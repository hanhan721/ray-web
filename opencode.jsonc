{
  "$schema": "https://opencode.ai/config.json",
  // Project-local MCP servers. V2 shape: server definitions live under mcp.servers.
  // Both servers are launched with `npx -y`, so nothing is added to package.json / pnpm-lock.yaml.
  "mcp": {
    // `npx -y <pkg>@latest` downloads the package on first launch; give it room to finish.
    "timeout": {
      "startup": 120000
    },
    "servers": {
      "shadcn": {
        "type": "local",
        // shadcn-vue MCP: browse/search/install registry items.
        "command": ["mise", "exec", "node@26", "--", "npx", "-y", "shadcn-vue@latest", "mcp"],
        // Resolve from the project root so mise picks up mise.toml (Node 26.13.0).
        "cwd": ".",
        "environment": {
          "HTTP_PROXY": "http://127.0.0.1:8800",
          "HTTPS_PROXY": "http://127.0.0.1:8800"
        }
      },
      "playwright": {
        "type": "local",
        "command": ["mise", "exec", "node@26", "--", "npx", "-y", "@playwright/mcp@latest"],
        "environment": {
          "PLAYWRIGHT_MCP_PROXY_SERVER": "http://127.0.0.1:8800",
          "PLAYWRIGHT_MCP_PROXY_BYPASS": "localhost,127.0.0.1,[::1]",
          "PLAYWRIGHT_BROWSERS_PATH": "D:\\cache\\playwright\\ray"
        }
      }
    }
  }
}
