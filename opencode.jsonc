{
  "$schema": "https://opencode.ai/config.json",
  // Project-local MCP servers. V2 shape: server definitions live under mcp.servers.
  // Both servers are launched with `npx -y`, so nothing is added to package.json / pnpm-lock.yaml.
  "mcp": {
    // `npx -y <pkg>@latest` downloads the package on first launch; give it room to finish.
    "timeout": {
      "startup": 120000,
    },
    "servers": {
      "shadcn": {
        "type": "local",
        // shadcn-vue MCP: browse/search/install registry items.
        "command": ["npx", "-y", "shadcn-vue@latest", "mcp"],
        // Resolve from the project root so mise picks up mise.toml (Node 26.13.0).
        "cwd": ".",
        // The OpenCode host injects HTTP(S)_PROXY without a URL scheme (e.g. 127.0.0.1:8800).
        // npm rejects it with ERR_INVALID_URL while resolving `@latest`, so clear it for this
        // local server; the npm registry is reachable directly. Remove these four lines once
        // the host supplies a scheme-prefixed proxy, or if this machine truly needs a proxy.
        "environment": {
          "HTTP_PROXY": "",
          "HTTPS_PROXY": "",
          "http_proxy": "",
          "https_proxy": "",
        },
      },
      "playwright": {
        "type": "local",
        // Browser automation, interaction testing, screenshots and UI verification.
        "command": ["npx", "-y", "@playwright/mcp@latest"],
        "cwd": ".",
        // Same host proxy workaround; harmless when no proxy env is set.
        "environment": {
          "HTTP_PROXY": "",
          "HTTPS_PROXY": "",
          "http_proxy": "",
          "https_proxy": "",
        },
      },
    },
  },
}
